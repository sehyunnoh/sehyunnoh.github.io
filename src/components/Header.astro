---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/about">About Me</HeaderLink>
			<HeaderLink href="/tags">Tags</HeaderLink>
			<div class="dropdown">
				<span class="dropdown-trigger">Diary</span>
				<div class="dropdown-menu">
					<HeaderLink href="/diary/dev">Dev</HeaderLink>
					<HeaderLink href="/diary/book">Book</HeaderLink>
					<HeaderLink href="/diary/movie">Movie</HeaderLink>
				</div>
			</div>
			<div class="dropdown">
				<span class="dropdown-trigger">Hobby</span>
				<div class="dropdown-menu">
					<HeaderLink href="/hobby/pickleball">Pickleball</HeaderLink>
					<HeaderLink href="/hobby/tapdance">Tap Dance</HeaderLink>
					<HeaderLink href="/hobby/jumprope">Jump Rope</HeaderLink>
				</div>
			</div>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.dropdown {
		position: relative;
	}
	.dropdown-trigger {
		padding: 1em 0.5em;
		cursor: pointer;
		color: rgb(var(--black));
		display: flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 1rem;
		user-select: none;
	}
	.dropdown-trigger::after {
		content: '▾';
		font-size: 0.75em;
	}
	.dropdown-menu {
		display: none;
		position: absolute;
		top: 100%;
		right: 0;
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		box-shadow: var(--box-shadow);
		min-width: 130px;
		z-index: 100;
		flex-direction: column;
		padding: 0.25rem 0;
	}
	.dropdown-menu a {
		padding: 0.5em 1em;
		display: block;
		border-bottom: none;
		white-space: nowrap;
	}
	.dropdown-menu a:hover {
		background: rgb(var(--gray-light));
		color: var(--accent);
	}
	.dropdown:hover .dropdown-menu {
		display: flex;
	}
</style>
