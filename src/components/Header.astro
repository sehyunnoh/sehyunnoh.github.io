---
import { SITE_TITLE } from '../consts';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { localePrefix } from '../i18n/utils';
import HeaderLink from './HeaderLink.astro';
import LanguageToggle from './LanguageToggle.astro';

interface Props {
	locale: Locale;
	/** 글 페이지처럼 짝이 따로 있는 경우 토글이 갈 주소를 넘긴다 */
	altHrefs?: Partial<Record<Locale, string>>;
}

const { locale, altHrefs } = Astro.props;
const t = useTranslations(locale);
const p = localePrefix(locale);
---

<header>
	<nav>
		<h2><a href={p || '/'}>{SITE_TITLE}</a></h2>
		<LanguageToggle locale={locale} hrefs={altHrefs} />
		<!-- 좁은 화면에서 메뉴를 접는 토글. 체크박스라 JS 없이 동작하고,
		     탭으로 열리므로 hover가 없는 터치 기기에서도 문제가 없다. -->
		<input type="checkbox" id="nav-toggle" class="nav-toggle" />
		<label for="nav-toggle" class="nav-toggle-label" aria-label={t('nav.menu')}>
			<span class="nav-toggle-bars"></span>
		</label>
		<div class="internal-links">
			<HeaderLink href={`${p}/about`}>About Me</HeaderLink>
			<HeaderLink href={`${p}/projects`}>Projects</HeaderLink>
			<HeaderLink href={`${p}/tags`}>Tags</HeaderLink>
			<div class="dropdown">
				<span class="dropdown-trigger">Notes</span>
				<div class="dropdown-menu">
					<HeaderLink href={`${p}/diary/dev`}>Dev</HeaderLink>
					<HeaderLink href={`${p}/diary/book`}>Book</HeaderLink>
					<HeaderLink href={`${p}/diary/movie`}>Movie</HeaderLink>
					<HeaderLink href={`${p}/diary/english`}>English</HeaderLink>
					<HeaderLink href={`${p}/diary/study`}>Study</HeaderLink>
					<HeaderLink href={`${p}/diary/dailythoughts`}>Daily Thoughts</HeaderLink>
				</div>
			</div>
			<div class="dropdown">
				<span class="dropdown-trigger">Hobby</span>
				<div class="dropdown-menu">
					<HeaderLink href={`${p}/hobby/pickleball`}>Pickleball</HeaderLink>
					<HeaderLink href={`${p}/hobby/tapdance`}>Tap Dance</HeaderLink>
					<HeaderLink href={`${p}/hobby/jumprope`}>Jump Rope</HeaderLink>
					<HeaderLink href={`${p}/hobby/basketball`}>Basketball</HeaderLink>
					<HeaderLink href={`${p}/hobby/volleyball`}>Volleyball</HeaderLink>
				</div>
			</div>
			<div class="dropdown">
				<span class="dropdown-trigger">Family</span>
				<div class="dropdown-menu">
					<HeaderLink href={`${p}/family/travel`}>Travel</HeaderLink>
					<HeaderLink href={`${p}/family/exercises`}>Exercises</HeaderLink>
					<HeaderLink href={`${p}/family/music`}>Music</HeaderLink>
					<HeaderLink href={`${p}/family/study`}>Study</HeaderLink>
				</div>
			</div>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	nav > h2 {
		order: 1;
	}
	.internal-links {
		order: 2;
		margin-left: auto;
	}
	nav > :global(.lang) {
		order: 3;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}
	.dropdown {
		position: relative;
	}
	.dropdown-trigger {
		padding: 1em 0.5em;
		cursor: pointer;
		color: rgb(var(--black));
		display: flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 1rem;
		user-select: none;
	}
	.dropdown-trigger::after {
		content: '▾';
		font-size: 0.75em;
	}
	.dropdown-menu {
		display: none;
		position: absolute;
		top: 100%;
		right: 0;
		background: white;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		box-shadow: var(--box-shadow);
		min-width: 130px;
		z-index: 100;
		flex-direction: column;
		padding: 0.25rem 0;
	}
	.dropdown-menu a {
		padding: 0.5em 1em;
		display: block;
		border-bottom: none;
		white-space: nowrap;
	}
	.dropdown-menu a:hover {
		background: rgb(var(--gray-light));
		color: var(--accent);
	}
	.dropdown:hover .dropdown-menu {
		display: flex;
	}

	/* 토글은 넓은 화면에서 필요 없다 */
	.nav-toggle,
	.nav-toggle-label {
		display: none;
	}

	/* 좁은 화면에서는 체크박스를 눈에서만 감춘다. display:none으로 지우면
	   키보드 포커스를 받지 못해 메뉴를 열 방법이 없어진다. */
	@media (max-width: 720px) {
		.nav-toggle {
			display: block;
			position: absolute;
			width: 1px;
			height: 1px;
			margin: 0;
			opacity: 0;
			pointer-events: none;
		}
	}

	/*
	  좁은 화면: 링크가 6개 + 드롭다운 3개라 한 줄에 절대 들어가지 않는다.
	  가로로 밀려 나가 페이지 전체가 옆으로 스크롤되던 것을 접이식 메뉴로 바꾼다.
	  드롭다운은 여기서 hover 없이 전부 펼쳐 보여준다 — 터치에는 hover가 없다.
	*/
	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
		}
		/* 언어 토글과 햄버거를 오른쪽에 나란히, 메뉴는 아랫줄 전체 */
		nav > :global(.lang) {
			order: 2;
			margin-left: auto;
		}
		.nav-toggle-label {
			order: 3;
		}
		.internal-links {
			order: 4;
			margin-left: 0;
		}
		.nav-toggle-label {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 44px;
			height: 44px;
			margin: 0.25em 0;
			cursor: pointer;
			border-radius: 6px;
		}
		.nav-toggle-label:hover {
			background: rgb(var(--gray-light));
		}
		/* 햄버거 아이콘: 가운데 막대 하나에 위아래를 가상 요소로 붙인다 */
		.nav-toggle-bars,
		.nav-toggle-bars::before,
		.nav-toggle-bars::after {
			display: block;
			width: 22px;
			height: 2px;
			background: rgb(var(--black));
			border-radius: 2px;
		}
		.nav-toggle-bars::before,
		.nav-toggle-bars::after {
			content: '';
			position: relative;
		}
		.nav-toggle-bars::before {
			top: -7px;
		}
		.nav-toggle-bars::after {
			top: 5px;
		}
		.nav-toggle:focus-visible + .nav-toggle-label {
			outline: 2px solid var(--accent);
			outline-offset: 2px;
		}

		.internal-links {
			display: none;
			flex-basis: 100%;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding-bottom: 0.5em;
			max-height: calc(100dvh - 60px);
			overflow-y: auto;
		}
		.nav-toggle:checked ~ .internal-links {
			display: flex;
		}
		.internal-links > a {
			padding: 0.75em 0.5em;
			border-bottom: 1px solid rgb(var(--gray-light));
		}
		.internal-links > a.active {
			border-bottom-color: var(--accent);
		}

		/* 드롭다운을 그 자리에서 펼친 목록으로 */
		.dropdown {
			border-bottom: 1px solid rgb(var(--gray-light));
		}
		.dropdown-trigger {
			padding: 0.75em 0.5em;
			font-weight: 700;
			cursor: default;
		}
		.dropdown-trigger::after {
			content: none;
		}
		.dropdown-menu,
		.dropdown:hover .dropdown-menu {
			display: flex;
			position: static;
			border: none;
			border-radius: 0;
			box-shadow: none;
			min-width: 0;
			padding: 0 0 0.5em 0;
		}
		.dropdown-menu a {
			padding: 0.5em 0.5em 0.5em 1.5em;
		}
	}
</style>
