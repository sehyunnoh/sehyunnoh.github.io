---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	tags?: string[];
	locale: Locale;
	alternates?: Partial<Record<Locale, string>>;
	/** false면 이 언어 번역이 없어 기본 언어 본문을 보여주고 있다는 뜻 */
	translated?: boolean;
}

import type { ImageMetadata } from 'astro';
import type { Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { localePrefix } from '../i18n/utils';
import { tagLabel } from '../i18n/tags';

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	locale,
	alternates,
	translated = true,
} = Astro.props;

const t = useTranslations(locale);
const p = localePrefix(locale);
---

<html lang={locale}>
	<head>
		<BaseHead title={title} description={description} image={heroImage} locale={locale} alternates={alternates} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5rem;
				margin-top: 0.75rem;
			}
			/* Preflight가 hr의 기본 margin을 지워서 태그/제목에 그대로 붙는다 */
			.title hr {
				margin-top: 1.5rem;
			}
			.tag {
				display: inline-block;
				padding: 0.25rem 0.75rem;
				background: rgb(var(--gray-light));
				border-radius: 999px;
				font-size: 0.85rem;
				text-decoration: none;
				color: rgb(var(--gray-dark));
				transition: background 0.15s ease;
			}
			.tag:hover {
				background: var(--accent);
				color: white;
			}
			.fallback-notice {
				margin: 1.5em 0 0 0;
				padding: 0.75em 1em;
				background: rgb(var(--gray-light));
				border-radius: 8px;
				font-size: 0.9em;
				color: rgb(var(--gray-dark));
				text-align: center;
			}
		</style>
	</head>

	<body>
		<Header locale={locale} altHrefs={alternates} />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					{!translated && <p class="fallback-notice">{t('post.koOnly')}</p>}
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										{t('post.lastUpdated')} <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							tags.length > 0 && (
								<div class="tags">
									{tags.map((tag) => (
										<a href={`${p}/tags/${tag}/`} class="tag">
											#{tagLabel(tag, locale)}
										</a>
									))}
								</div>
							)
						}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
