---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const diaryPosts = await getCollection('diary');
	const hobbyPosts = await getCollection('hobby');
	const allPosts = [...diaryPosts, ...hobbyPosts];

	const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

	return tags.map((tag) => ({
		params: { tag },
		props: {
			posts: allPosts
				.filter((post) => post.data.tags.includes(tag))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
			diaryIds: new Set(diaryPosts.map((p) => p.id)),
		},
	}));
}

const { tag, posts, diaryIds } = Astro.props;

function getPostUrl(post: (typeof posts)[number]) {
	const parts = post.id.split('/');
	const collection = diaryIds.has(post.id) ? 'diary' : 'hobby';
	return `/${collection}/${parts[0]}/${parts.slice(1).join('/')}/`;
}
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`#${tag} | ${SITE_TITLE}`} description={`'${tag}' 태그가 붙은 글 목록`} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.tag-heading {
				display: flex;
				align-items: baseline;
				gap: 0.75rem;
			}
			.tag-heading h1 {
				margin: 0;
			}
			.post-count {
				font-size: 1rem;
				color: rgb(var(--gray));
			}
			.back-link {
				display: inline-block;
				margin-bottom: 1.5rem;
				font-size: 0.9rem;
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.back-link:hover {
				color: var(--accent);
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 1.5rem 0 0;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.post-item a {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				text-decoration: none;
				padding: 0.75rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
				gap: 1rem;
			}
			.post-item a:hover .post-title {
				color: var(--accent);
			}
			.post-title {
				margin: 0;
				font-size: 1.1rem;
				font-weight: 600;
				color: rgb(var(--black));
			}
			.post-date {
				font-size: 0.875rem;
				color: rgb(var(--gray));
				white-space: nowrap;
				flex-shrink: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a href="/tags/" class="back-link">← 전체 태그</a>
			<div class="tag-heading">
				<h1>#{tag}</h1>
				<span class="post-count">{posts.length}개의 글</span>
			</div>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li class="post-item">
							<a href={getPostUrl(post)}>
								<h2 class="post-title">{post.data.title}</h2>
								<span class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
