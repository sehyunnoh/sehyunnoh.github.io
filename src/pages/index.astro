---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const diaryPosts = await getCollection('diary');
const hobbyPosts = await getCollection('hobby');

const recentPosts = [...diaryPosts, ...hobbyPosts]
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

function getPostUrl(post: (typeof recentPosts)[number]) {
	const parts = post.id.split('/');
	const collection = diaryPosts.includes(post as typeof diaryPosts[number]) ? 'diary' : 'hobby';
	return `/${collection}/${parts[0]}/${parts.slice(1).join('/')}/`;
}
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.intro {
				margin-bottom: 3rem;
			}
			.intro h1 {
				margin-bottom: 0.5rem;
			}
			.intro p {
				color: rgb(var(--gray));
				margin: 0;
			}
			.recent-title {
				font-size: 1.25rem;
				margin-bottom: 1.5rem;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.post-item a {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				text-decoration: none;
				padding: 0.75rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
				gap: 1rem;
			}
			.post-item a:hover .post-title {
				color: var(--accent);
			}
			.post-title {
				margin: 0;
				font-size: 1.1rem;
				font-weight: 600;
				color: rgb(var(--black));
			}
			.post-date {
				font-size: 0.875rem;
				color: rgb(var(--gray));
				white-space: nowrap;
				flex-shrink: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="intro">
				<h1>안녕하세요 👋</h1>
				<p>개발일기와 취미 활동을 기록하는 공간입니다.</p>
			</div>
			<h2 class="recent-title">최근 글</h2>
			<ul class="post-list">
				{
					recentPosts.map((post) => (
						<li class="post-item">
							<a href={getPostUrl(post)}>
								<h3 class="post-title">{post.data.title}</h3>
								<span class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
