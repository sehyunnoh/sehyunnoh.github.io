---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';

export function getStaticPaths() {
	return [
		{ params: { category: 'travel' } },
		{ params: { category: 'exercises' } },
		{ params: { category: 'music' } },
		{ params: { category: 'study' } },
	];
}

const categoryLabels: Record<string, string> = {
	travel: 'Travel',
	exercises: 'Exercises',
	music: 'Music',
	study: 'Study',
};

const { category } = Astro.params;
const label = categoryLabels[category];

const allPosts = await getCollection('family');
const posts = allPosts
	.filter((post) => post.id.startsWith(category + '/'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`${label} | ${SITE_TITLE}`} description={`${label} 기록`} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			.post-item a {
				display: block;
				text-decoration: none;
				padding: 1.5rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				transition: box-shadow 0.2s ease;
			}
			.post-item a:hover {
				box-shadow: var(--box-shadow);
			}
			.post-title {
				margin: 0 0 0.25rem 0;
				font-size: 1.25rem;
				color: rgb(var(--black));
			}
			.post-date {
				margin: 0 0 0.5rem 0;
				font-size: 0.875rem;
				color: rgb(var(--gray));
			}
			.post-desc {
				margin: 0 0 0.75rem 0;
				font-size: 1rem;
				color: rgb(var(--gray-dark));
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}
			.tag {
				display: inline-block;
				padding: 0.2rem 0.6rem;
				background: rgb(var(--gray-light));
				border-radius: 999px;
				font-size: 0.8rem;
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{label}</h1>
			{
				posts.length === 0 ? (
					<p>아직 작성된 글이 없습니다.</p>
				) : (
					<ul class="post-list">
						{posts.map((post) => {
							const slug = post.id.split('/').slice(1).join('/');
							return (
								<li class="post-item">
									<a href={`/family/${category}/${slug}/`}>
										<h2 class="post-title">{post.data.title}</h2>
										<p class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<p class="post-desc">{post.data.description}</p>
									{post.data.tags.length > 0 && (
										<div class="tags">
											{post.data.tags.map((tag) => (
												<span class="tag">#{tag}</span>
											))}
										</div>
									)}
									</a>
								</li>
							);
						})}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>
