---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { PROJECTS } from '../../data/projects';
import { LOCALES, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { localeToParam } from '../../i18n/utils';

export function getStaticPaths() {
	return LOCALES.map((locale) => ({
		params: { locale: localeToParam(locale) },
		props: { locale },
	}));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead
			title={`Projects | ${SITE_TITLE}`}
			description={t('projects.desc')}
			locale={locale}
		/>
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.intro {
				margin: 0 0 2rem 0;
				color: rgb(var(--gray-dark));
			}
			.project-grid {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 1.5rem;
			}
			.project-card {
				display: flex;
				flex-direction: column;
				height: 100%;
				box-sizing: border-box;
				text-decoration: none;
				padding: 1.5rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				background: white;
				transition:
					box-shadow 0.2s ease,
					transform 0.2s ease;
			}
			.project-card:hover {
				box-shadow: var(--box-shadow);
				transform: translateY(-2px);
			}
			.project-name {
				margin: 0 0 0.5rem 0;
				font-size: 1.25rem;
				color: rgb(var(--black));
			}
			.project-desc {
				margin: 0 0 1rem 0;
				font-size: 1rem;
				color: rgb(var(--gray-dark));
				flex-grow: 1;
			}
			.project-host {
				margin: 0;
				font-size: 0.875rem;
				color: var(--accent);
			}
			.project-host::after {
				content: ' ↗';
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin: 0 0 0.75rem 0;
			}
			.tag {
				display: inline-block;
				padding: 0.2rem 0.6rem;
				background: rgb(var(--gray-light));
				border-radius: 999px;
				font-size: 0.8rem;
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>
	<body>
		<Header locale={locale} />
		<main>
			<h1>Projects</h1>
			<p class="intro">{t('projects.intro')}</p>
			<ul class="project-grid">
				{
					PROJECTS.map((project) => (
						<li>
							<a
								class="project-card"
								href={project.url}
								target="_blank"
								rel="noopener noreferrer"
							>
								<h2 class="project-name">{project.name}</h2>
								<p class="project-desc">{project.description[locale]}</p>
								{project.tags && project.tags.length > 0 && (
									<div class="tags">
										{project.tags.map((tag) => (
											<span class="tag">#{tag}</span>
										))}
									</div>
								)}
								<p class="project-host">{new URL(project.url).hostname}</p>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
