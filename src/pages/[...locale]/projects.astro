---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { SITE_TITLE } from '../../consts';
import { PROJECT_GROUPS, PROJECTS } from '../../data/projects';
import { LOCALES, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { localeToParam } from '../../i18n/utils';

export function getStaticPaths() {
	return LOCALES.map((locale) => ({
		params: { locale: localeToParam(locale) },
		props: { locale },
	}));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const featured = PROJECTS.filter((p) => p.featured);

// 그룹 순서는 PROJECT_GROUPS가 정한다. 그룹을 안 적은 항목은 맨 아래로 모은다.
const sections = PROJECT_GROUPS.map((g) => ({
	title: g.label[locale],
	items: PROJECTS.filter((p) => !p.featured && p.group === g.id),
})).filter((s) => s.items.length > 0);

const ungrouped = PROJECTS.filter(
	(p) => !p.featured && !PROJECT_GROUPS.some((g) => g.id === p.group),
);
if (ungrouped.length > 0) {
	sections.push({ title: t('projects.other'), items: ungrouped });
}
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead
			title={`Projects | ${SITE_TITLE}`}
			description={t('projects.desc')}
			locale={locale}
		/>
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.intro {
				margin: 0 0 2rem 0;
				color: rgb(var(--gray-dark));
			}
			.project-grid {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: 1.5rem;
			}
			.project-section {
				margin-top: 3rem;
			}
			.section-title {
				font-size: 1.1rem;
				margin: 0 0 1rem 0;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>
	<body>
		<Header locale={locale} />
		<main>
			<h1>Projects</h1>
			<p class="intro">{t('projects.intro')}</p>
			{
				featured.length > 0 && (
					<ul class="project-grid featured">
						{featured.map((project) => (
							<li>
								<ProjectCard project={project} locale={locale} />
							</li>
						))}
					</ul>
				)
			}
			{
				sections.map((section) => (
					<section class="project-section">
						<h2 class="section-title">{section.title}</h2>
						<ul class="project-grid">
							{section.items.map((project) => (
								<li>
									<ProjectCard project={project} locale={locale} />
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
