---
import BaseHead from '../../../../components/BaseHead.astro';
import Footer from '../../../../components/Footer.astro';
import FormattedDate from '../../../../components/FormattedDate.astro';
import Header from '../../../../components/Header.astro';
import { SITE_TITLE } from '../../../../consts';
import { LOCALES, type Locale } from '../../../../i18n/config';
import { tagLabel } from '../../../../i18n/tags';
import { useTranslations } from '../../../../i18n/ui';
import { getPostsFor, localeToParam, postUrl } from '../../../../i18n/utils';

const categoryLabels: Record<string, string> = {
	travel: 'Travel',
	exercises: 'Exercises',
	music: 'Music',
	study: 'Study',
};

export function getStaticPaths() {
	return LOCALES.flatMap((locale) =>
		[
			{ category: 'travel' },
			{ category: 'exercises' },
			{ category: 'music' },
			{ category: 'study' },
		].map((c) => ({
			params: { locale: localeToParam(locale), category: c.category },
			props: { locale },
		})),
	);
}

const { category } = Astro.params;
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const label = categoryLabels[category!];

const posts = (await getPostsFor(locale)).filter(
	(post) => post.collection === 'family' && post.category === category,
);
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead
			title={`${label} | ${SITE_TITLE}`}
			description={t('list.categoryDesc')(label)}
			locale={locale}
		/>
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			.post-item a {
				display: block;
				text-decoration: none;
				padding: 1.5rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				transition: box-shadow 0.2s ease;
			}
			.post-item a:hover {
				box-shadow: var(--box-shadow);
			}
			.post-title {
				margin: 0 0 0.25rem 0;
				font-size: 1.25rem;
				color: rgb(var(--black));
			}
			.post-date {
				margin: 0 0 0.5rem 0;
				font-size: 0.875rem;
				color: rgb(var(--gray));
			}
			.post-desc {
				margin: 0 0 0.75rem 0;
				font-size: 1rem;
				color: rgb(var(--gray-dark));
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
			}
			.tag {
				display: inline-block;
				padding: 0.2rem 0.6rem;
				background: rgb(var(--gray-light));
				border-radius: 999px;
				font-size: 0.8rem;
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>
	<body>
		<Header locale={locale} />
		<main>
			<h1>{label}</h1>
			{
				posts.length === 0 ? (
					<p>{t('list.empty')}</p>
				) : (
					<ul class="post-list">
						{posts.map((post) => (
							<li class="post-item">
								<a href={postUrl(post, locale)}>
									<h2 class="post-title">{post.entry.data.title}</h2>
									<p class="post-date">
										<FormattedDate date={post.entry.data.pubDate} />
									</p>
									<p class="post-desc">{post.entry.data.description}</p>
									{post.entry.data.tags.length > 0 && (
										<div class="tags">
											{post.entry.data.tags.map((tag: string) => (
												<span class="tag">#{tagLabel(tag, locale)}</span>
											))}
										</div>
									)}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>
