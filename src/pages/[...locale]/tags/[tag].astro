---
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import { LOCALES, type Locale } from '../../../i18n/config';
import { tagLabel } from '../../../i18n/tags';
import { useTranslations } from '../../../i18n/ui';
import { getPostsFor, localePrefix, localeToParam, postUrl } from '../../../i18n/utils';

export async function getStaticPaths() {
	const paths = [];
	for (const locale of LOCALES) {
		const all = await getPostsFor(locale);
		const tags = [...new Set(all.flatMap((post) => post.entry.data.tags as string[]))];
		for (const tag of tags) {
			paths.push({
				params: { locale: localeToParam(locale), tag },
				props: {
					locale,
					posts: all.filter((post) => (post.entry.data.tags as string[]).includes(tag)),
				},
			});
		}
	}
	return paths;
}

const { tag } = Astro.params;
const { locale, posts } = Astro.props as {
	locale: Locale;
	posts: Awaited<ReturnType<typeof getPostsFor>>;
};
const t = useTranslations(locale);
const p = localePrefix(locale);
const label = tagLabel(tag!, locale);
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead
			title={`#${label} | ${SITE_TITLE}`}
			description={t('tags.taggedDesc')(label)}
			locale={locale}
		/>
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.tag-heading {
				display: flex;
				align-items: baseline;
				gap: 0.75rem;
			}
			.tag-heading h1 {
				margin: 0;
			}
			.post-count {
				font-size: 1rem;
				color: rgb(var(--gray));
			}
			.back-link {
				display: inline-block;
				margin-bottom: 1.5rem;
				font-size: 0.9rem;
				color: rgb(var(--gray));
				text-decoration: none;
			}
			.back-link:hover {
				color: var(--accent);
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 1.5rem 0 0;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.post-item a {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				text-decoration: none;
				padding: 0.75rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
				gap: 1rem;
			}
			.post-item a:hover .post-title {
				color: var(--accent);
			}
			.post-title {
				margin: 0;
				font-size: 1.1rem;
				font-weight: 600;
				color: rgb(var(--black));
			}
			.post-date {
				font-size: 0.875rem;
				color: rgb(var(--gray));
				white-space: nowrap;
				flex-shrink: 0;
			}
		</style>
	</head>
	<body>
		<Header locale={locale} />
		<main>
			<a href={`${p}/tags/`} class="back-link">{t('tags.all')}</a>
			<div class="tag-heading">
				<h1>#{label}</h1>
				<span class="post-count">{t('tags.count')(posts.length)}</span>
			</div>
			<ul class="post-list">
				{posts.map((post) => (
						<li class="post-item">
							<a href={postUrl(post, locale)}>
								<h2 class="post-title">{post.entry.data.title}</h2>
								<p class="post-date">
									<FormattedDate date={post.entry.data.pubDate} />
								</p>
								<p class="post-desc">{post.entry.data.description}</p>
							</a>
						</li>
					))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
