---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { LOCALES, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getPostsFor, localeToParam, postUrl } from '../../i18n/utils';

export function getStaticPaths() {
	return LOCALES.map((locale) => ({
		params: { locale: localeToParam(locale) },
		props: { locale },
	}));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const recentPosts = (await getPostsFor(locale)).slice(0, 5);
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={SITE_TITLE} description={t('site.description')} locale={locale} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			.intro {
				margin-bottom: 3rem;
			}
			.intro h1 {
				margin-bottom: 0.5rem;
			}
			.intro p {
				color: rgb(var(--gray));
				margin: 0;
			}
			.recent-title {
				font-size: 1.25rem;
				margin-bottom: 1.5rem;
				padding-bottom: 0.5rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.post-item a {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				text-decoration: none;
				padding: 0.75rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
				gap: 1rem;
			}
			.post-item a:hover .post-title {
				color: var(--accent);
			}
			.post-title {
				margin: 0;
				font-size: 1.1rem;
				font-weight: 600;
				color: rgb(var(--black));
			}
			.post-date {
				font-size: 0.875rem;
				color: rgb(var(--gray));
				white-space: nowrap;
				flex-shrink: 0;
			}
		</style>
	</head>
	<body>
		<Header locale={locale} />
		<main>
			<div class="intro">
				<h1>{t('home.greeting')}</h1>
				<p>{t('site.description')}</p>
			</div>
			<h2 class="recent-title">{t('home.recent')}</h2>
			<ul class="post-list">
				{recentPosts.map((post) => (
							<li class="post-item">
								<a href={postUrl(post, locale)}>
									<h3 class="post-title">{post.entry.data.title}</h3>
									<span class="post-date">
										<FormattedDate date={post.entry.data.pubDate} />
									</span>
								</a>
							</li>
						))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
